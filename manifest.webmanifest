{
  "name": "PWA Hub",
  "short_name": "PWA Hub",
  "description": "Deine persönliche Startseite für installierbare Web-Apps.",
  "lang": "de",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#070914",
  "theme_color": "#070914",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./pwa-hub-icon.jpg",
      "sizes": "1280x1280",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ]
}

